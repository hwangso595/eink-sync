{
  "name": "eink-sync",
  "version": "0.3.6",
  "description": "Sync reMarkable documents, notebooks, and highlights with Obsidian over SFTP or Syncthing",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "lint": "eslint .",
    "install-plugin": "node scripts/install-plugin.mjs",
    "release": "node scripts/release.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "remarkable",
    "pdf",
    "highlights",
    "sync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/ssh2": "^1.15.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.5.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "ssh2": "^1.15.0"
  }
}
